# Example terraform variables file
# Copy this file to terraform.tfvars and update with your values

resource_group_name = "rg-azureaifoundry-dev"
location            = "eastus2"

subscription_id             = "" # Workload subscription ID
# private_dns_subscription_id = "" # Subscription ID containing the Private DNS Zones

# Environment Configuration
environment_prefix = "dev"
workload          = "aif"
location          = "eastus2"
data_location     = ""  # Defaults to location if not specified

tags = {
  Environment = "dev"
  Project     = "AzureAIFoundry"
  ManagedBy   = "Terraform"
}

enable_rbac = true

# false = Foundry account is publicly reachable (Entra ID auth still required).
# true  = private endpoint only; Terraform and clients must run from the VNet.
enable_private_networking = false

# Existing networking and Private DNS Zones are required.
existing_resource_group_name                 = "rg-aoai-dev"
existing_network_resource_group_name         = "rg-network-dev"
existing_vnet_name                           = "vnet-dev"
existing_private_endpoint_subnet_name        = "snet-private-endpoints"
existing_agent_subnet_name                    = "snet-foundry-agents"
# existing_private_dns_zone_resource_group_name = "rg-private-dns"

# Optional YAML Terraform template path; defaults to the module's template.
agent_definition_template_file = ""

# OpenAI Configuration
# openai_deployment_name = "gpt41"
# openai_model_name      = "gpt-4.1"
# openai_model_version   = "2025-04-14"
# openai_model_sku_name  = "GlobalStandard"
# openai_model_sku_capacity = 50

# GPT-5.6 Luna profile (model version 2026-07-09).
# Confirm region/quota availability and agent API compatibility before switching.
openai_deployment_name     = "gpt-5.6-luna"
openai_model_name          = "gpt-5.6-luna"
openai_model_version       = "2026-07-09"
openai_model_sku_name      = "GlobalStandard"